flowchart TD
    user["Presenter<br/>human decision authority"]:::human

    subgraph PUB["Public context: display only"]
        cel["CelesTrak GP + SOCRATES<br/>manual refresh only"]:::ext
        snap[("Dated snapshots<br/>data/ + .cache/")]:::store
        sgp4["Validate; SGP4 display<br/>+ SOCRATES screen"]:::det
    end

    subgraph RL["Synthetic RL path"]
        enc["Synthetic Hill-frame<br/>encounter, 1-6 objects"]:::mock
        gen0["Gen 0 COAST rollout<br/>local, untrained"]:::det
        ctl["Training controller<br/>background process"]:::det
        cem["CEM linear policy search<br/>Daytona sandbox, optional"]:::ai
        val["Host validation<br/>hashes, checkpoint replay"]:::eval
        runs[(".cache/daytona_rl<br/>result, last_verified")]:::store
    end

    lead["Fictional lead-time fixture<br/>options + committee brief"]:::mock
    app["Streamlit app.py<br/>5 tabs, Plotly views"]:::det

    user -->|inject buttons| enc
    user -->|TRAIN button| ctl
    cel -.->|REFRESH IF DUE| snap
    snap --> sgp4
    enc --> gen0
    enc -->|frozen request| ctl
    ctl -->|job + worker bundle| cem
    cem -->|weights + replays| val
    val -->|verified envelope| runs
    sgp4 -->|globe + screen views| app
    gen0 -->|Gen 0 replay| app
    runs -->|Gen 0-10 replay + passport| app
    lead -->|tabs 02-04| app

